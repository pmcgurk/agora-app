# Copy to .env. `docker compose up` works without one using development defaults,
# but change every secret below before exposing Agora beyond your own machine.

POSTGRES_DB=agora
POSTGRES_USER=agora
POSTGRES_PASSWORD=change-me-db-password

# MinIO's official images were removed from Docker Hub; this community fork is the default.
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_REGION=us-east-1
MINIO_BUCKET=agora-media
MINIO_ROOT_USER=agora_minio
MINIO_ROOT_PASSWORD=change-me-minio-password

# Public URLs as seen by browsers. Use https:// URLs when deploying; https also marks the
# session cookie Secure. Presigned media URLs are signed for MINIO_PUBLIC_ENDPOINT.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Largest single upload in MB (videos go browser -> MinIO directly). Images are capped at 50.
MAX_UPLOAD_MB=5120
# Origin allowed to upload to MinIO from the browser; set to your site URL in production.
# MINIO_CORS_ORIGIN=https://example.com

# Payments. With a Stripe key set, paid tiers use real Stripe Checkout and ALLOW_FREE_SUBSCRIPTIONS is ignored.
# Add a webhook endpoint in Stripe pointing at <NEXT_PUBLIC_BASE_URL>/api/stripe/webhook (events:
# checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.updated,
# customer.subscription.deleted, charge.refunded) and paste its signing secret below.
# Optional: you can instead paste these keys in Settings > Monetization (saved keys take precedence).
# STRIPE_SECRET_KEY=sk_live_or_test_key
# STRIPE_WEBHOOK_SECRET=whsec_...
# Without Stripe, true lets any patron "buy" a paid tier for free (demo/testing only); false allows only free follows.
ALLOW_FREE_SUBSCRIPTIONS=true

# Set to true once to create demo users (demo@agora.local / patron@agora.local, password
# "demo-password"). Never enable on a public instance.
SEED_DEMO_DATA=false

# Only for running `npm run dev` outside Docker (services published on localhost).
# docker compose builds its own connection strings from the values above.
DATABASE_URL=postgresql://agora:change-me-db-password@localhost:5433/agora?schema=public
MINIO_ENDPOINT=http://localhost:9000

# Host port for Postgres (only used for local tooling; the app uses the internal network)
POSTGRES_HOST_PORT=5433
