generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  PATRON
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum PaymentStatus {
  PAID
  REFUNDED
}

enum PaymentKind {
  SUBSCRIPTION
  TIP
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  passwordHash     String
  // Set once the address is confirmed (by link, or because a trusted flow already proved it).
  emailVerifiedAt  DateTime?
  emailTokens      EmailToken[]
  role             Role
  themeName        String           @default("default")
  themeSettings    Json?
  // Public page name used in /creators/<slug>; falls back to the id when unset.
  slug             String?          @unique
  tagline          String?
  bio              String?
  // ISO 4217 code with two decimal places; tier prices are stored in minor units.
  currency         String           @default("USD")
  // Set when a creator finishes (or skips) the onboarding workflow.
  onboardedAt      DateTime?
  // Creators opt in to paid tiers; without it they only have the free Follower tier.
  acceptsPayments  Boolean          @default(false)
  // Creators can take one-off tips from patrons, independently of paid tiers.
  tipsEnabled      Boolean          @default(false)
  // Shown to someone right after they leave a tip.
  tipThanks        String?
  // How the feed loads more posts: "scroll" (infinite scrolling) or "pages".
  feedPaging       String           @default("scroll")
  // Posts per scroll batch or page.
  feedPageSize     Int              @default(5)
  showPoweredBy    Boolean          @default(true)
  // Google Font choices (keys from src/themes/fonts.ts); null keeps the theme's font.
  fontBody         String?
  fontHeading      String?
  // Notification switches; creators use comments and likes, patrons use posts and replies.
  notifyComments   Boolean          @default(true)
  notifyLikes      Boolean          @default(true)
  notifyPosts      Boolean          @default(true)
  notifyReplies    Boolean          @default(true)
  // Creators can switch direct messages from patrons on or off.
  allowDMs         Boolean          @default(false)
  // When set, only patrons on this tier (or a pricier one) can message the creator.
  dmMinTierId      String?
  dmMinTier        Tier?            @relation("DmTier", fields: [dmMinTierId], references: [id], onDelete: SetNull)
  // Object keys in MinIO (never URLs); served through /api/avatar/<userId>.
  avatarKey        String?
  bannerKey        String?
  // Social profile links keyed by platform (see src/lib/social-links.ts).
  socialLinks      Json?
  stripeCustomerId String?          @unique
  blocksMade       Block[]          @relation("BlocksMade")
  blockedBy        Block[]          @relation("BlockedBy")
  paymentsMade     Payment[]        @relation("PatronPayments")
  paymentsTaken    Payment[]        @relation("CreatorPayments")
  messagesSent     Message[]        @relation("MessagesSent")
  messagesGot      Message[]        @relation("MessagesReceived")
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  comments         Comment[]
  likes            PostLike[]
  commentLikes     CommentLike[]
  notifications    Notification[]   @relation("Recipient")
  mutedTiers       TierMute[]
  profileViews     ProfileViewDay[]
  createdTiers     Tier[]           @relation("CreatorTiers")
  subscriptions    Subscription[]   @relation("PatronSubscriptions")
  posts            Post[]           @relation("CreatorPosts")
  sessions         Session[]
  invitesSent      CreatorInvite[] @relation("InvitesSent")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tier {
  id              String         @id @default(cuid())
  creatorId       String
  name            String
  price           Int
  stripePriceId   String?
  description     String?
  // Turned-off tiers stop accepting new members; existing members keep their access.
  active          Boolean        @default(true)
  // Shown on the support page as a checklist, one line per perk.
  perks           String[]       @default([])
  // Optional label such as "Most popular", and whether the card is emphasised.
  badge           String?
  // Shown to a patron right after they join this tier.
  welcomeMessage  String?
  highlighted     Boolean        @default(false)
  mutes           TierMute[]
  payments        Payment[]
  dmGatedFor      User[]         @relation("DmTier")
  creator         User           @relation("CreatorTiers", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  minimumForPosts Post[]         @relation("MinimumTier")
}

model Subscription {
  id                   String             @id @default(cuid())
  patronId             String
  tierId               String
  status               SubscriptionStatus
  createdAt            DateTime           @default(now())
  // Gifted subscriptions are granted by the creator and are never counted as revenue.
  gifted               Boolean            @default(false)
  // Null means the subscription does not expire.
  expiresAt            DateTime?
  stripeSubscriptionId String?            @unique
  // The plan stays active until expiresAt and is not renewed.
  cancelAtPeriodEnd    Boolean            @default(false)
  patron               User               @relation("PatronSubscriptions", fields: [patronId], references: [id], onDelete: Cascade)
  tier                 Tier               @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([patronId, tierId])
  @@index([tierId])
}

model Post {
  id               String        @id @default(cuid())
  creatorId        String
  title            String
  textContent      String
  createdAt        DateTime      @default(now())
  isPublic         Boolean       @default(false)
  minTierId        String?
  // Lets viewers without access reveal a heavily blurred copy of each image.
  allowBlurPreview Boolean       @default(false)
  // When false, viewers without access see a blurred video thumbnail instead of a clear one.
  clearThumbnail   Boolean       @default(false)
  editedAt         DateTime?
  // null = draft, in the future = scheduled, in the past = published. Defaults to now, so posts made any
  // other way (the API, seeding) are published straight away.
  publishedAt      DateTime?     @default(now())
  // When subscribers and webhooks were told about the post; null until then.
  announcedAt      DateTime?
  // The readable part of the post address, unique per creator. Posts opened by id still work.
  slug             String?
  comments         Comment[]
  likes            PostLike[]
  views            PostViewDay[]
  // Lets viewers without access watch the first N seconds of each video.
  previewSeconds   Int?
  media            PostMedia[]
  creator          User          @relation("CreatorPosts", fields: [creatorId], references: [id], onDelete: Cascade)
  minTier          Tier?         @relation("MinimumTier", fields: [minTierId], references: [id], onDelete: SetNull)

  @@unique([creatorId, slug])
  @@index([creatorId, publishedAt])
}

// Files live in MinIO only (Rule 1); this table stores object keys, never file contents.
model PostMedia {
  id                 String    @id @default(cuid())
  postId             String
  position           Int
  kind               MediaKind
  contentType        String
  size               BigInt
  objectKey          String
  // Original file name, kept for generic FILE attachments (downloads).
  fileName           String?
  // Images embedded in the post text. They are not shown in the attachment gallery.
  inline             Boolean   @default(false)
  // Server-generated derivatives, safe to show to viewers who cannot see the original.
  blurObjectKey      String?
  previewObjectKey   String?
  thumbObjectKey     String?
  thumbBlurObjectKey String?
  post               Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  // Set for replies; replies are one level deep.
  parentId  String?
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("Replies")
  likes     CommentLike[]
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// Daily counters keep analytics cheap: no per-visitor rows are stored.
model PostViewDay {
  postId String
  day    DateTime @db.Date
  views  Int      @default(0)
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, day])
}

model ProfileViewDay {
  creatorId String
  day       DateTime @db.Date
  views     Int      @default(0)
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([creatorId, day])
}

// Singleton row (id "instance") holding instance-wide switches.
model InstanceSetting {
  id                  String  @id @default("instance")
  isPrivate           Boolean @default(false)
  // Off: one creator, whose page is the home page. On: the owner can invite more creators.
  multiCreator        Boolean @default(false)
  // The creator who completed setup; they manage invites. Null on installs made before this existed.
  ownerId             String?
  // Stripe credentials entered in Settings; they take precedence over the environment variables.
  stripeSecretKey     String?
  stripeWebhookSecret String?
  // How new creators join a multi-creator site (see CreatorSignupMode).
  creatorSignup       CreatorSignupMode @default(INVITE)
  // Outgoing mail. Entered in Settings > Email; when unset, the MAIL_* environment variables are used.
  smtpHost            String?
  smtpPort            Int?
  smtpSecure          Boolean @default(false)
  smtpUser            String?
  smtpPassword        String?
  mailFrom            String?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  message   String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A row means the creator does not want "new follower" notifications for this tier.
model TierMute {
  userId String
  tierId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier   Tier   @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([userId, tierId])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

// A blocked user cannot follow, subscribe, comment, like or message the creator, and loses access.
model Block {
  creatorId String
  userId    String
  createdAt DateTime @default(now())
  creator   User     @relation("BlocksMade", fields: [creatorId], references: [id], onDelete: Cascade)
  user      User     @relation("BlockedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@id([creatorId, userId])
}

// Amounts are in minor units. Test checkout records payments too, so refunds work end to end.
model Payment {
  id                      String        @id @default(cuid())
  // Null for guest tips (made without an account); subscriptions always have a patron.
  patronId                String?
  creatorId               String
  tierId                  String?
  // Tips are one-off payments with no tier; the tipper may leave a short message.
  kind                    PaymentKind   @default(SUBSCRIPTION)
  message                 String?
  // Name shown to the creator for a tip; null means the tipper chose to stay anonymous.
  tipperName              String?
  amount                  Int
  currency                String
  status                  PaymentStatus @default(PAID)
  createdAt               DateTime      @default(now())
  refundedAt              DateTime?
  stripePaymentIntentId   String?
  stripeInvoiceId         String?       @unique
  stripeCheckoutSessionId String?       @unique
  patron                  User?         @relation("PatronPayments", fields: [patronId], references: [id], onDelete: Cascade)
  creator                 User          @relation("CreatorPayments", fields: [creatorId], references: [id], onDelete: Cascade)
  tier                    Tier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([patronId, creatorId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  sender      User      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
}

// Only a hash of the key is stored; the full key is shown once when it is created.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Webhook {
  id            String    @id @default(cuid())
  userId        String
  url           String
  // Used to sign every delivery (HMAC-SHA256).
  secret        String
  events        String[]
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime?
  // HTTP status of the last attempt; null when it never connected.
  lastStatus    Int?
  lastError     String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Stripe retries webhooks, so every processed event id is remembered to keep handling idempotent.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// A pending invitation for another creator. Only a hash of the token is stored.
model CreatorInvite {
  id          String    @id @default(cuid())
  email       String
  name        String
  slug        String?
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("InvitesSent", fields: [createdById], references: [id], onDelete: Cascade)
}

enum CreatorSignupMode {
  // The owner invites every creator.
  INVITE
  // Anyone can create a creator account from the sign-up page.
  OPEN
  // Anyone can apply; the owner approves or rejects each application.
  APPROVAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A request from someone who wants a creator account on a site that asks for approval.
model CreatorApplication {
  id           String            @id @default(cuid())
  name         String
  email        String
  passwordHash String
  slug         String?
  about        String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  @@index([status, createdAt])
}

// People who asked to be told when hosted Agora opens. Only the public demo collects these, and
// its hourly reset leaves this table alone.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

enum EmailTokenKind {
  PASSWORD_RESET
  VERIFY_EMAIL
}

// A single-use link sent by email. Only a hash of the token is stored, so a database leak cannot be
// used to reset anyone's password.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// A sign-up waiting for the address owner to finish it from the link in their email. Only a hash of the link is
// stored. Nothing here is an account: it cannot log in, so a stranger who types someone else's address gets nothing.
model PendingSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
